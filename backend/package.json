{
  "name": "agendafacil-backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "API REST do Agenda Fácil em Node.js e Express",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seed.js",
    "outbox": "node src/outbox.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "lint": "eslint src tests",
    "format": "prettier --write src tests package.json eslint.config.js nodemon.json",
    "format:check": "prettier --check src tests package.json eslint.config.js nodemon.json"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "nodemailer": "^10.0.16"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9"
  },
  "overrides": {
    "nodemon": {
      "chokidar": "^4.0.3"
    }
  }
}
